      "type": "integer",
      "title": "Device Count"
     },
     "orders": {
      "items": {
       "additionalProperties": true,
       "type": "object"
      },
      "type": "array",
      "title": "Orders"
     }
    },
    "type": "object",
    "required": [
     "id",
     "email",
     "persona_count",
     "device_count",
     "orders"
    ],
    "title": "MeOut"
   },
   "PairIn": {
    "properties": {
     "name": {
