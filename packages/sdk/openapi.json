   },
   "DeviceOut": {
    "properties": {
     "id": {
      "type": "string",
      "title": "Id"
     },
     "name": {
      "type": "string",
      "title": "Name"
     },
     "pairing_code": {
      "type": "string",
      "title": "Pairing Code"
     },
     "status": {
      "type": "string",
      "title": "Status"
     },
     "fw_version": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Fw Version"
     },
     "last_pose": {
      "anyOf": [
       {
        "additionalProperties": true,
        "type": "object"
       },
       {
        "type": "null"
       }
      ],
      "title": "Last Pose"
     },
     "last_vbat": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "title": "Last Vbat"
     },
     "estopped": {
      "type": "boolean",
      "title": "Estopped"
     },
     "last_seen_at": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Last Seen At"
     },
     "online": {
      "type": "boolean",
      "title": "Online"
     }
    },
    "type": "object",
    "required": [
     "id",
     "name",
     "pairing_code",
     "status",
     "fw_version",
     "last_pose",
     "last_vbat",
     "estopped",
     "last_seen_at",
     "online"
    ],
    "title": "DeviceOut"
   },
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "type": "array",
      "title": "Detail"
     }
    },
    "type": "object",
    "title": "HTTPValidationError"
   },
   "IdentityModel": {
    "properties": {
     "name": {
      "type": "string",
      "maxLength": 60,
      "minLength": 1,
      "title": "Name"
     },
     "disposition": {
      "type": "string",
      "title": "Disposition",
      "default": ""
     },
     "values": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Values",
      "default": []
     },
     "voice": {
      "type": "string",
      "title": "Voice",
      "default": ""
     },
     "hard_rules": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Hard Rules",
      "default": []
     },
     "boot_greeting": {
      "type": "string",
      "title": "Boot Greeting",
      "default": ""
     },
     "version": {
      "type": "string",
      "title": "Version",
      "default": "1.0"
     }
    },
    "type": "object",
    "required": [
     "name"
    ],
    "title": "IdentityModel",
    "description": "Mirrors packages/core/persona/identity.json."
