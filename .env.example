# ── Exobod platform env ─────────────────────────────────────────────
# Everything is OPTIONAL for local dev: with zero vars the stack runs on
# sqlite + in-process body sim + dev auth + the deterministic mock mind.

# apps/api ------------------------------------------------------------
# DATABASE_URL=postgresql+asyncpg://exobod:exobod@localhost:5432/exobod
# FERNET_KEY=                       # `python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"` — REQUIRED in prod
# LINK_KIND=local                   # local | zmq | serial
# REFLEX_ENDPOINT=tcp://127.0.0.1:5555
# CORS_ORIGINS=http://localhost:3000
# WEB_ORIGIN=http://localhost:3000

# Clerk (omit both to run keyless dev-auth)
# CLERK_JWKS_URL=https://<your-instance>.clerk.accounts.dev/.well-known/jwks.json
# CLERK_ISSUER=https://<your-instance>.clerk.accounts.dev

# Stripe (test mode works; omit to keep preorders "not open yet")
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PREORDER_PRICE_ID=price_...   # optional; falls back to $199 price_data
# PREORDER_AMOUNT_USD=199

# Server-side model keys (optional — BYOK via the console supersedes these)
# ANTHROPIC_API_KEY=  OPENAI_API_KEY=  DEEPSEEK_API_KEY=  GLM_API_KEY=
# OLLAMA_HOST=http://localhost:11434

# apps/web ------------------------------------------------------------
# NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...
