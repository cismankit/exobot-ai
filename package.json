{
  "name": "exobod",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "dev:web": "pnpm --filter @exobod/web dev",
    "dev:api": "sh infra/dev-api.sh",
    "test:core": "sh -c 'cd packages/core && ../../.venv/bin/python -m pytest tests/ -q'",
    "test:api": "sh -c 'cd apps/api && ../../.venv/bin/python -m pytest tests/ -q'",
    "sdk:generate": "pnpm --filter @exobod/sdk generate"
  },
  "devDependencies": {
    "turbo": "^2.3.3"
  },
  "packageManager": "pnpm@10.29.2",
  "pnpm": {
    "overrides": {
      "@types/react": "19.0.2",
      "@types/react-dom": "19.0.2"
    }
  },
  "engines": {
    "node": ">=20"
  }
}
